#include <Servo.h>
#include <Stepper.h>

const int pasosPorVuelta = 2048;

Servo tender;
Servo servo1;
Servo servo2;

const int pinServo1 = 5;
const int pinServo2 = 6;
const int pinTender = 3;

Stepper motor(pasosPorVuelta, 8, 10, 9, 11);

int sensorAgua = A1;
int valorAgua;
int umbral1 = 300;

bool toldoExtendido = false;

const int rele = 7;

const int sensorHumedad = A0;
int valorHumedad;
const int umbral2 = 900;

void setup() {
  Serial.begin(9600);

  tender.attach(pinTender);
  tender.write(90);
  Serial.println("Tender afuera");

  servo1.attach(pinServo1);
  servo2.attach(pinServo2);

  servo1.write(0);
  servo2.write(0);
  Serial.println("Ventanas abiertas");

  motor.setSpeed(10);

  pinMode(rele, OUTPUT);
  digitalWrite(rele, HIGH); // Bomba apagada (relé activo en HIGH)

  Serial.println("Sistema iniciado");
}

void loop() {

  valorAgua = analogRead(sensorAgua);
  
  Serial.print("Valor del agua/sensor: ");
  Serial.println(valorAgua);
  
  valorHumedad = analogRead(sensorHumedad);
  
  Serial.print("Humedad de la tierra: ");
  Serial.println(valorHumedad);

  if (valorAgua > umbral1 && !toldoExtendido) {

    Serial.println("SENSOR MOJADO");

    tender.write(0);
    Serial.println("Tender bajo techo");

    servo1.write(90);
    servo2.write(90);
    Serial.println("Ventanas cerradas");

    Serial.println("Extendiendo toldo...");
    motor.step(12288); // 6 vueltas
    Serial.println("Toldo extendido. Motor detenido.");

    toldoExtendido = true;
  }

  else if (valorAgua <= umbral1 && toldoExtendido) {

    Serial.println("SENSOR SECO");

    tender.write(90);
    Serial.println("Tender afuera");

    servo1.write(0);
    servo2.write(0);
    Serial.println("Ventanas abiertas");

    Serial.println("Guardando toldo...");
    motor.step(-12288); // 6 vueltas inversas
    Serial.println("Toldo guardado. Motor detenido.");

    toldoExtendido = false;
  }

  if (valorHumedad > umbral2) {
    Serial.println("TIERRA SECA");
    Serial.println("Encendiendo bomba...");

    digitalWrite(rele, LOW);
    delay(3000);

    digitalWrite(rele, HIGH);
    Serial.println("Bomba apagada");
  } 
  
  else if (valorHumedad <= umbral2) {
    Serial.println("TIERRA HUMEDA");
    digitalWrite(rele, HIGH);
    Serial.println("Bomba apagada");
  }

  delay(500);
}
