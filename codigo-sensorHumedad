const int rele = 7;

const int sensorHumedad = A0;
int valorHumedad;
const int umbral1 = 900;

void setup() {
  Serial.begin(9600);

  pinMode(rele, OUTPUT);
  digitalWrite(rele, HIGH); // Bomba apagada (relé activo en HIGH)
}

void loop() {
  valorHumedad = analogRead(sensorHumedad);

  Serial.print("Humedad de la tierra: ");
  Serial.println(valorHumedad);

  if (valorHumedad > umbral1) {
    Serial.println("TIERRA SECA");
    Serial.println("Encendiendo bomba...");

    digitalWrite(rele, HIGH);
    delay(3000);

    digitalWrite(rele, LOW);
    Serial.println("Bomba apagada");

  } else {
    Serial.println("TIERRA HUMEDA");
    digitalWrite(rele, LOW);
    Serial.println("Bomba apagada");
  }

  delay(500);
}
