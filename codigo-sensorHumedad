int rele = 7;

int sensorHumedad = A0;
int valorHumedad;
int umbral = 600;

void setup() {
  Serial.begin(9600);
  
  pinMode(rele, OUTPUT);
  digitalWrite(rele, HIGH); //Bomba apagada al comenzar
}

void loop() {
  valorHumedad = analogRead(sensorHumedad);
  Serial.print("Humedad de la tierra: ");
  Serial.println(valorHumedad);

  if (valorHumedad > umbral) //Si la tierra está seca
  {
    Serial.println("TIERRA SECA");

    digitalWrite(rele, LOW);
    Serial.println("Encendiendo bomba...");
    delay(3000); //La bomba riega durante 3 segundos
    digitalWrite(rele, HIGH);
    delay(1000);
  }
  else 
  {
    Serial.println("TIERRA HÚMEDA");
    Serial.println("Bomba apagada");
    digitalWrite(rele, HIGH);
  }

  delay(500);
}
