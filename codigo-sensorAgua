#include <Servo.h>
#include <Stepper.h>

const int pasosPorVuelta = 2048;

Servo tender;
Servo servo1;
Servo servo2;

int Servo1 = 4;
int Servo2 = 3;
int Tender = 7;

Stepper motor(pasosPorVuelta, 8, 10, 9, 11);

int sensorAgua = A0;
int valorAgua;
int umbral = 300;

// Estado del toldo
bool toldoExtendido = false;

void setup() {
  Serial.begin(9600);

  tender.attach(Tender);
  tender.write(0);

  servo1.attach(Servo1);
  servo2.attach(Servo2);

  servo1.write(0);
  servo2.write(0);

  motor.setSpeed(10);

  Serial.println("Sistema iniciado");
}

void loop() {

  valorAgua = analogRead(sensorAgua);

  Serial.print("Valor del agua/sensor: ");
  Serial.println(valorAgua);

  if (valorAgua > umbral && !toldoExtendido) {

    Serial.println("AGUA DETECTADA");

    tender.write(90);
    Serial.println("Tender bajo techo");

    servo1.write(90);
    servo2.write(90);
    Serial.println("Ventanas cerradas");

    Serial.println("Extendiendo toldo...");
    motor.step(12288); // 6 vueltas
    toldoExtendido = true;
    Serial.println("Toldo extendido. Motor detenido.");
  }

  else if (valorAgua <= umbral && toldoExtendido) {

    Serial.println("SENSOR SECO");

    tender.write(0);
    Serial.println("Tender afuera");

    servo1.write(0);
    servo2.write(0);
    Serial.println("Ventanas abiertas");

    Serial.println("Guardando toldo...");
    motor.step(-12288); // 6 vueltas inversas
    toldoExtendido = false;
    Serial.println("Toldo guardado. Motor detenido.");
  }

  delay(500);
}
